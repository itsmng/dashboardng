{#
/**
 * Dashboard NG - Loading Spinner Component
 *
 * @var string message The loading message (default: "Loading...")
 */
#}
<div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">{{ message|default('Loading...') }}</span>
    </div>
</div>

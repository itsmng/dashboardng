{#
/**
 * Dashboard NG - Coming Soon Component
 *
 * @var string title The alert title
 * @var string message The main message
 * @var string subtext Additional subtext
 * @var string link_url Optional link URL
 * @var string link_text Optional link text
 * @var string link_icon Optional link icon class (default: "fa fa-tachometer-alt")
 */
#}
<div class="alert alert-info" role="alert">
    <h4 class="alert-heading">
        <i class="fa fa-info-circle me-2"></i>
        {{ title|default('Feature Coming Soon') }}
    </h4>
    <p>{{ message }}</p>
    <hr>
    <p class="mb-0">
        {{ subtext|default('For now, please use the main Dashboard page.') }}
    </p>
</div>
{% if link_url is defined and link_text is defined %}
<div class="text-center mt-5">
    <a href="{{ link_url }}" class="btn btn-primary btn-lg">
        <i class="{{ link_icon|default('fa fa-tachometer-alt') }} me-2"></i>
        {{ link_text }}
    </a>
</div>
{% endif %}

{% extends 'layouts/base.twig' %}

{% block content %}
<div id="dashboardng-charts" class="container-fluid py-3">
    {% set message = translations.chart_under_development|format(chart_type_label) %}
    {% include 'components/coming_soon.twig' with {
        'title': translations.charts_coming_soon,
        'message': message,
        'subtext': translations.for_now_use_dashboard,
        'link_url': plugin_dir ~ '/front/dashboard.php',
        'link_text': translations.go_to_main_dashboard
    } %}
</div>
{% endblock %}

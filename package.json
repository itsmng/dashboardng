{
    "name": "dashboardng",
    "version": "1.0.0",
    "description": "Dashboard Plugin for ITSM-NG",
    "private": true,
    "scripts": {
        "build": "esbuild js/dashboard.js js/mydashboard.js js/assetReports.js js/taskReports.js js/ticketReports.js js/entitySelector.js --bundle --minify --format=esm --sourcemap --outdir=js/dist --target=es2020",
        "lint": "oxlint js/",
        "lint:fix": "oxlint js/ --fix",
        "typecheck": "tsc --noEmit --allowJs --checkJs js/**/*.js"
    },
    "dependencies": {
        "chart.js": "^4.5.1",
        "gridstack": "^12.2.2",
        "htm": "^3.1.1",
        "preact": "^10.19.3"
    },
    "keywords": [
        "glpi",
        "itsm-ng",
        "dashboard",
        "plugin"
    ],
    "author": "ITSMNG Team",
    "license": "GPL-3.0",
    "devDependencies": {
        "esbuild": "^0.21.5",
        "oxlint": "^1.0.0",
        "typescript": "^5.9.3"
    }
}

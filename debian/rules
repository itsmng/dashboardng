#!/usr/bin/make -f

SHELL := /bin/bash

# Variables
NAME = dashboardng
VERSION = CHANGEVERSION

%:
	dh $@

override_dh_auto_install:

	composer install --no-dev -n
	npm install
	npm run build

	mkdir -p usr/share/itsm-ng/plugins/$(NAME)
	find . -mindepth 1 -maxdepth 1 \
		! -name usr \
		! -name debian \
		! -name .git \
                ! -name tools \
		! -name README.md \
		! -name composer.lock \
		! -name composer.json \
		! -name package-lock.json \
		! -name package.json \
		! -name tsconfig.json \
		! -name .oxlintrc.json \
		-exec cp -a {} usr/share/itsm-ng/plugins/$(NAME)/ \;

override_dh_gencontrol:
	dh_gencontrol -- -v$(VERSION)
